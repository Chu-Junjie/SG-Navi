{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task 24 approved reviewed zh-Hans explanation sidecar, distinct from Action Plan 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "overlay_version",
    "locale",
    "translation_status",
    "reviewed_by",
    "reviewed_at",
    "is_official_translation",
    "disclaimer",
    "canonical",
    "display",
    "entries_sha256"
  ],
  "properties": {
    "overlay_version": {
      "const": "task24-reviewed-1.0"
    },
    "locale": {
      "const": "zh-Hans"
    },
    "translation_status": {
      "const": "approved_explanation"
    },
    "reviewed_by": {
      "const": "Chu-Junjie"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_official_translation": {
      "const": false
    },
    "disclaimer": {
      "type": "string",
      "minLength": 6
    },
    "canonical": {
      "$ref": "#/$defs/canonical"
    },
    "display": {
      "$ref": "#/$defs/display"
    },
    "entries_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1800
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "field",
        "prompt",
        "reason",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "prompt": {
          "$ref": "#/$defs/text"
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": [
                  "string",
                  "boolean",
                  "number",
                  "null"
                ]
              },
              "label": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subject",
        "body",
        "slots"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/text"
        },
        "subject": {
          "$ref": "#/$defs/text"
        },
        "body": {
          "$ref": "#/$defs/text"
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "institution",
        "purpose",
        "note",
        "kind",
        "value",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "institution": {
          "$ref": "#/$defs/text"
        },
        "purpose": {
          "$ref": "#/$defs/text"
        },
        "note": {
          "type": [
            "null",
            "string"
          ]
        },
        "kind": {
          "enum": [
            "web",
            "phone",
            "email"
          ]
        },
        "value": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "assessment",
        "primary_action",
        "checklist",
        "details",
        "contacts",
        "draft"
      ],
      "properties": {
        "headline": {
          "$ref": "#/$defs/text"
        },
        "assessment": {
          "$ref": "#/$defs/claim"
        },
        "primary_action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "text",
            "evidence_ids",
            "label",
            "kind",
            "contact_id"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "$ref": "#/$defs/text"
            },
            "evidence_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "label": {
              "$ref": "#/$defs/text"
            },
            "kind": {
              "type": "string"
            },
            "contact_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "checklist": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "title",
              "items"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "title": {
                "$ref": "#/$defs/text"
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/claim"
                }
              }
            }
          }
        },
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contact"
          }
        },
        "draft": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/draft"
            }
          ]
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message",
        "context_summary",
        "question",
        "plan"
      ],
      "properties": {
        "message": {
          "$ref": "#/$defs/text"
        },
        "context_summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "question": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/question"
            }
          ]
        },
        "plan": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/plan"
            }
          ]
        }
      }
    },
    "canonical": {
      "type": "object",
      "required": [
        "action_plan_version",
        "request_id",
        "state",
        "reason",
        "message",
        "context",
        "revision",
        "question",
        "plan"
      ],
      "properties": {
        "action_plan_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string"
        },
        "state": {
          "enum": [
            "CONFIRM",
            "ASK",
            "READY",
            "LIMITED",
            "UNAVAILABLE"
          ]
        },
        "reason": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "context": {
          "type": [
            "object",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "question": {
          "type": [
            "object",
            "null"
          ]
        },
        "plan": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
