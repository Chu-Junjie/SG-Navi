{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sg-navi.invalid/shared/guidance_contract.json",
  "title": "SG Navi integrated guidance 1.0 (Task 15)",
  "description": "Frozen additive integration: intake1.0 confirmation -> query-RAG1.0 -> results0.1 -> display1.0/context. /api/navigate1.0 remains compatible. GUIDANCE_ONLY is conditional research context, never legal eligibility or a supported legal Action Card.",
  "endpoints": {"intake": "/api/intake", "confirm": "/api/intake/confirm", "guidance": "/api/guidance"},
  "$defs": {
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["guidance_version", "confirmed", "case_type", "confirmed_answers", "confirmation_revision", "query"],
      "properties": {
        "guidance_version": {"const": "1.0"}, "confirmed": {"const": true},
        "case_type": {"enum": ["rental_deposit", "consumer_complaint"]},
        "confirmed_answers": {"type": "object"},
        "confirmation_revision": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
        "query": {"type": ["string", "null"], "minLength": 1, "maxLength": 300, "pattern": "^[a-zA-Z0-9 ,.!?'-]+$"}
      },
      "allOf": [
        {"if": {"properties": {"case_type": {"const": "rental_deposit"}}}, "then": {"properties": {"confirmed_answers": {"$ref": "https://sg-navi.invalid/frontend/schemas/rental_deposit_input.schema.json"}}}},
        {"if": {"properties": {"case_type": {"const": "consumer_complaint"}}}, "then": {"properties": {"confirmed_answers": {"$ref": "https://sg-navi.invalid/frontend/schemas/consumer_complaint_input.schema.json"}}}}
      ]
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "input_type", "required"],
      "properties": {"id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}, "input_type": {"enum": ["text", "number", "select"]}, "required": {"const": true}}
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["guidance_version", "rule_version", "source_version", "context_version", "confirmation_revision", "result_id", "guidance_status", "questions", "research_guidance", "display_evidence", "claim_citations", "matched_evidence_ids", "query_status", "query_fallback", "unresolved_fields", "action_card", "limitations"],
      "properties": {
        "guidance_version": {"const": "1.0"}, "rule_version": {"const": "mock-1"},
        "source_version": {"type": ["string", "null"]}, "context_version": {"type": ["string", "null"]},
        "confirmation_revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{20}$"},
        "result_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{24}$"},
        "guidance_status": {"enum": ["CLARIFICATION_REQUIRED", "GUIDANCE_ONLY", "LIMITED_REFERRAL", "ERROR"]},
        "questions": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/question"}},
        "research_guidance": {"type": ["object", "null"]},
        "display_evidence": {"type": "array", "maxItems": 64, "items": {"allOf": [{"$ref": "https://sg-navi.invalid/shared/display_evidence_contract.json#/$defs/display_record"}, {"required": ["display_context"]}]}},
        "claim_citations": {"type": "array", "maxItems": 256, "items": {"$ref": "https://sg-navi.invalid/shared/display_evidence_contract.json#/$defs/claim"}},
        "matched_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "query_status": {"enum": ["FOUND", "NO_RESULTS", "ERROR", "NOT_RUN"]}, "query_fallback": {"type": "boolean"},
        "unresolved_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "action_card": {"const": null}, "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "allOf": [
        {"if": {"properties": {"guidance_status": {"const": "GUIDANCE_ONLY"}}}, "then": {"properties": {"research_guidance": {"type": "object"}, "result_id": {"type": "string"}, "display_evidence": {"minItems": 1}, "claim_citations": {"minItems": 1}, "questions": {"maxItems": 0}}}, "else": {"properties": {"research_guidance": {"type": "null"}, "display_evidence": {"maxItems": 0}, "claim_citations": {"maxItems": 0}, "matched_evidence_ids": {"maxItems": 0}}}},
        {"if": {"properties": {"guidance_status": {"const": "CLARIFICATION_REQUIRED"}}}, "then": {"properties": {"questions": {"minItems": 1}}}}
      ]
    }
  }
}
